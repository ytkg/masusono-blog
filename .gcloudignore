# Cloud Run source deploy ignore rules
# Ref: https://cloud.google.com/sdk/gcloud/reference/topic/gcloudignore

.git
.gitignore

# Local development dependencies and caches
node_modules/
tmp/
log/

# Local secrets
config/master.key
config/credentials/*.key

# Local editor/OS artifacts
.DS_Store

# Repository tooling and alternate checkouts are not application sources.
/.git
/.worktrees
/.codex
/.agents
/deployment-policy
/gha-creds-*.json
/.env*
/.github

# Old checkouts can retain ignored secrets, databases, and build artifacts here.
/backend
