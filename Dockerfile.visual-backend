# syntax=docker/dockerfile:1
# Visual tests mount the application and build frontend assets in the Vite service.
FROM node:22-bookworm-slim AS node

FROM ruby:4.0.7-slim

WORKDIR /rails
ENV RAILS_ENV=development \
    BUNDLE_DEPLOYMENT=0 \
    BUNDLE_WITHOUT="" \
    BUNDLE_PATH=/usr/local/bundle

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y curl libjemalloc2 sqlite3 imagemagick libmagickcore-7.q16-10-extra fonts-noto-cjk fonts-noto-color-emoji build-essential git libssl-dev libyaml-dev pkg-config && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists/*

ENV LD_PRELOAD=/usr/local/lib/libjemalloc.so

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY vendor/* ./vendor/
COPY Gemfile Gemfile.lock ./
RUN bundle install && \
    rm -rf /usr/local/bundle/ruby/*/cache
